<Page x:Class="ChangeLedger.Features.ChangesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:ChangeLedger.Shell"
      xmlns:f="clr-namespace:ChangeLedger.Features">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="Vis" />
    </Page.Resources>
    <Grid Margin="20,0,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0">
            <ui:Button x:Name="Preset1" Content="{l:T Changes.24h}" Margin="0,0,6,6" />
            <ui:Button x:Name="Preset7" Content="{l:T Changes.7d}" Margin="0,0,6,6" />
            <ui:Button x:Name="Preset30" Content="{l:T Changes.30d}" Margin="0,0,6,6" />
            <ui:Button x:Name="UpdateButton" Margin="0,0,16,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="UpdateText" Text="{l:T Changes.BeforeAfter}" />
                    <ui:SymbolIcon Symbol="ChevronDown16" Margin="6,0,0,0" />
                </StackPanel>
            </ui:Button>
            <ui:TextBox x:Name="SearchBox" PlaceholderText="{l:T Changes.Search}" Icon="{ui:SymbolIcon Search20}" Width="210" Margin="0,0,12,6" />
            <ui:ToggleSwitch x:Name="HiddenSwitch" Content="{l:T Changes.ShowHidden}" Margin="0,0,12,6" />
            <ui:Button x:Name="CopyButton" Icon="{ui:SymbolIcon Copy20}" Margin="0,0,0,6">
                <TextBlock x:Name="CopyText" Text="{l:T Changes.CopyAi}" />
            </ui:Button>
        </WrapPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,4">
            <ui:TextBlock Text="A" FontTypography="BodyStrong" VerticalAlignment="Center" Margin="0,0,6,6" />
            <DatePicker x:Name="ADate" Width="140" SelectedDateFormat="Short" Margin="0,0,6,6" />
            <ComboBox x:Name="ATime" Width="180" Margin="0,0,10,6" />
            <ui:TextBlock Text="→" FontTypography="BodyStrong" VerticalAlignment="Center" Margin="0,0,10,6" />
            <ui:TextBlock Text="B" FontTypography="BodyStrong" VerticalAlignment="Center" Margin="0,0,6,6" />
            <DatePicker x:Name="BDate" Width="140" SelectedDateFormat="Short" Margin="0,0,6,6" />
            <ComboBox x:Name="BTime" Width="180" Margin="0,0,0,6" />
        </WrapPanel>

        <TextBlock Grid.Row="2" x:Name="KeyText" TextWrapping="Wrap" Margin="0,2,0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <StackPanel Grid.Row="3" x:Name="Banners" />

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="Timeline" SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type f:DayRow}">
                        <StackPanel Margin="2,3" ToolTip="{Binding Tip}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Empty}" Value="True">
                                            <Setter Property="Opacity" Value="0.55" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock Text="{Binding Label}" FontTypography="BodyStrong" />
                                <ui:SymbolIcon Symbol="ArrowClockwise16" Margin="8,0,0,0" FontSize="14"
                                               Visibility="{Binding Reboot, Converter={StaticResource Vis}}">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Unexpected}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                    <Setter Property="Filled" Value="True" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                                <ui:SymbolIcon Symbol="WeatherMoon16" Margin="6,0,0,0" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Visibility="{Binding Wake, Converter={StaticResource Vis}}" />
                                <ui:SymbolIcon Symbol="ArrowDownload16" Margin="6,0,0,0" FontSize="14" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                               Visibility="{Binding Update, Converter={StaticResource Vis}}" />
                            </StackPanel>
                            <ui:TextBlock Text="{Binding Chips}" FontTypography="Caption" Appearance="Secondary" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Column="1" Margin="12,0,0,0">
                <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460" Visibility="Collapsed">
                    <ui:TextBlock x:Name="EmptyText" FontTypography="BodyStrong" TextWrapping="Wrap" TextAlignment="Center" />
                    <ui:Button x:Name="EmptySnapshot" Content="{l:T Changes.SnapshotNow}" Icon="{ui:SymbolIcon Camera20}" Appearance="Primary"
                               HorizontalAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>

                <ItemsControl x:Name="DiffList" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer CanContentScroll="True" Focusable="False" VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Resources>
                        <DataTemplate DataType="{x:Type f:HeaderRow}">
                            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="12,9" Margin="0,4,8,2" Cursor="Hand" MouseLeftButtonUp="Header_Click">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon FontSize="14" Margin="0,0,8,0" Visibility="{Binding HasRows, Converter={StaticResource Vis}}">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Symbol" Value="ChevronRight16" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Expanded}" Value="True">
                                                            <Setter Property="Symbol" Value="ChevronDown16" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                        <ui:TextBlock Text="{Binding Text}" FontTypography="BodyStrong" />
                                    </StackPanel>
                                    <ui:TextBlock Text="{Binding Note}" FontTypography="Caption" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                  TextWrapping="Wrap" Margin="22,2,0,0">
                                        <ui:TextBlock.Style>
                                            <Style TargetType="ui:TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Note}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:TextBlock.Style>
                                    </ui:TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type f:ChangeRow}">
                            <Grid Margin="14,3,8,3" Background="Transparent">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{l:T Changes.Copy}" Click="Copy_Click" />
                                        <MenuItem Header="{l:T Changes.CopyPath}" Click="CopyPath_Click" />
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" FontWeight="Bold" FontSize="15" VerticalAlignment="Top">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="+">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="-">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Grid.Column="1">
                                    <ui:TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                    <ui:TextBlock Text="{Binding Secondary}" FontTypography="Caption" Appearance="Secondary" TextWrapping="Wrap"
                                                  Visibility="{Binding HasSecondary, Converter={StaticResource Vis}}" />
                                    <ItemsControl ItemsSource="{Binding Lines}" Margin="0,2,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,1,0,0" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.Resources>
                </ItemsControl>
            </Grid>
        </Grid>
    </Grid>
</Page>
