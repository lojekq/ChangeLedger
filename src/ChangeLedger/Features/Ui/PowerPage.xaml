<Page x:Class="ChangeLedger.Features.PowerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:ChangeLedger.Shell"
      xmlns:f="clr-namespace:ChangeLedger.Features">
    <Grid Margin="20,0,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Grid.ColumnSpan="2">
            <ui:TextBlock FontTypography="Subtitle" Text="{l:T Power.Title}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <ComboBox x:Name="RangeBox" MinWidth="140">
                <ComboBoxItem Tag="7" Content="{l:T Power.Days7}" />
                <ComboBoxItem Tag="30" Content="{l:T Power.Days30}" />
                <ComboBoxItem Tag="90" Content="{l:T Power.Days90}" />
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" x:Name="Banners" />

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="12,0,8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Text="{l:T Power.Col.Time}" FontTypography="Caption" Appearance="Secondary" />
                <ui:TextBlock Grid.Column="1" Text="{l:T Power.Col.Event}" FontTypography="Caption" Appearance="Secondary" />
                <ui:TextBlock Grid.Column="2" Text="{l:T Power.Col.Cause}" FontTypography="Caption" Appearance="Secondary" />
                <ui:TextBlock Grid.Column="3" Text="{l:T Power.Col.Hint}" FontTypography="Caption" Appearance="Secondary" Margin="8,0,0,0" />
            </Grid>
            <ui:TextBlock Grid.Row="1" x:Name="EmptyText" Appearance="Tertiary" Margin="12,8,0,0" TextWrapping="Wrap" />
            <ItemsControl Grid.Row="1" x:Name="List">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type f:PowerRow}">
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,8,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock Text="{Binding Time}" FontTypography="Body" />
                                <ui:TextBlock Grid.Column="1" Text="{Binding Event}" FontTypography="BodyStrong" TextWrapping="Wrap" Margin="0,0,8,0">
                                    <ui:TextBlock.Style>
                                        <Style TargetType="ui:TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Unexpected}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:TextBlock.Style>
                                </ui:TextBlock>
                                <ui:TextBlock Grid.Column="2" Text="{Binding Cause}" TextWrapping="Wrap" Appearance="Secondary" Margin="0,0,8,0" />
                                <StackPanel Grid.Column="3" Margin="8,0,0,0">
                                    <ui:TextBlock Text="{Binding Hint}" TextWrapping="Wrap" FontTypography="Caption" />
                                    <ui:HyperlinkButton Content="{l:T Power.Before}" Padding="0" Margin="0,2,0,0" Click="Before_Click" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <Border Grid.Row="2" Grid.Column="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="8,20,0,0" VerticalAlignment="Top">
            <StackPanel>
                <ui:TextBlock Text="{l:T Power.WakeNow}" FontTypography="BodyStrong" Margin="0,0,0,8" />
                <ui:TextBlock Text="{l:T Power.WakeTasks}" FontTypography="Caption" Appearance="Secondary" />
                <ItemsControl x:Name="WakeTasks" Margin="0,2,0,10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:TextBlock Text="{l:T Power.WakeDevices}" FontTypography="Caption" Appearance="Secondary" />
                <ItemsControl x:Name="WakeDevices" Margin="0,2,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</Page>
