<UserControl x:Class="ChangeLedger.Features.SettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:ChangeLedger.Shell"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <StackPanel>
        <ui:TextBlock FontTypography="Subtitle" Text="{l:T Set.Title}" Margin="0,0,0,8" />

        <ui:CardControl Icon="{ui:SymbolIcon CalendarLtr24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="{l:T Set.Daily}" />
                    <ui:TextBlock Text="{l:T Set.Daily.Note}" FontTypography="Caption" Appearance="Secondary" TextWrapping="Wrap" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="TimeBox" Width="100" Margin="0,0,12,0" />
                <ui:ToggleSwitch x:Name="DailySwitch" />
            </StackPanel>
        </ui:CardControl>

        <ui:CardControl Icon="{ui:SymbolIcon Timer20}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="{l:T Set.Task}" />
                    <ui:TextBlock x:Name="TaskStatus" FontTypography="Caption" Appearance="Secondary" TextWrapping="Wrap" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:Button x:Name="RepairButton" Content="{l:T Set.Repair}" Icon="{ui:SymbolIcon Wrench20}" />
        </ui:CardControl>

        <ui:CardControl Icon="{ui:SymbolIcon Storage24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="{l:T Set.Keep}" />
                    <ui:TextBlock x:Name="UsageText" FontTypography="Caption" Appearance="Secondary" TextWrapping="Wrap" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:NumberBox x:Name="DaysBox" Width="130" Minimum="7" Maximum="3650" SmallChange="30" MaxDecimalPlaces="0" ClearButtonEnabled="False" />
                <ui:TextBlock Text="{l:T Set.Days}" VerticalAlignment="Center" Margin="6,0,14,0" />
                <ui:NumberBox x:Name="MbBox" Width="130" Minimum="50" Maximum="100000" SmallChange="100" MaxDecimalPlaces="0" ClearButtonEnabled="False" />
                <ui:TextBlock Text="{l:T Set.Mb}" VerticalAlignment="Center" Margin="6,0,0,0" />
            </StackPanel>
        </ui:CardControl>

        <ui:CardControl Icon="{ui:SymbolIcon ShieldKeyhole24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="{l:T Set.Secrets}" />
                    <ui:TextBlock Text="{l:T Set.Secrets.Note}" FontTypography="Caption" Appearance="Secondary" TextWrapping="Wrap" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:TextBox x:Name="SecretsBox" Width="240" PlaceholderText="MY_VAR, OTHER_VAR" />
        </ui:CardControl>

        <ui:CardControl Icon="{ui:SymbolIcon EyeOff24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="{l:T Set.Ignore}" />
                    <ui:TextBlock Text="{l:T Set.Ignore.Note}" FontTypography="Caption" Appearance="Secondary" TextWrapping="Wrap" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:TextBox x:Name="IgnoreBox" Width="360" MinHeight="64" MaxHeight="160" AcceptsReturn="True" TextWrapping="NoWrap"
                        VerticalScrollBarVisibility="Auto" PlaceholderText="firewall|^local\Microsoft\." />
        </ui:CardControl>

        <ui:CardControl Icon="{ui:SymbolIcon Alert24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="{l:T Set.Notify}" />
                    <ui:TextBlock Text="{l:T Set.Notify.Note}" FontTypography="Caption" Appearance="Secondary" TextWrapping="Wrap" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="NotifySwitch" />
        </ui:CardControl>

        <WrapPanel Margin="0,10,0,0">
            <ui:Button x:Name="SnapshotButton" Content="{l:T Changes.SnapshotNow}" Icon="{ui:SymbolIcon Camera20}" Appearance="Primary" Margin="0,0,8,8" />
            <ui:Button x:Name="FolderButton" Content="{l:T Set.Folder}" Icon="{ui:SymbolIcon FolderOpen20}" Margin="0,0,8,8" />
            <ui:Button x:Name="RebuildButton" Content="{l:T Set.Rebuild}" Icon="{ui:SymbolIcon ArrowSync20}" Margin="0,0,8,8" />
            <ui:Button x:Name="DeleteButton" Content="{l:T Set.Delete}" Icon="{ui:SymbolIcon Delete20}" Appearance="Danger" Margin="0,0,8,8" />
        </WrapPanel>
    </StackPanel>
</UserControl>
